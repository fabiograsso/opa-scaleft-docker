# Tokens for the OPA lab (docker-compose.yml / docker-compose-local.yml).
# Copy this file to .env and fill in the values from the OPA Console.
#
#   cp .env.example .env
#
# Leave a value empty to start the container unenrolled (it will log a warning
# and wait until you provide a token and restart it).

# Gateway setup token (Resource Administration > Gateways > Enrollment Tokens).
SFT_GATEWAY_SETUP_TOKEN=

# Infrastructure Orchestrator gateway setup token
# (create an "Infrastructure orchestrator" gateway setup token).
SFT_GATEWAY_INFRA_SETUP_TOKEN=

# Server enrollment token, shared by server1, server2, and server3
# (Resource Administration > Servers > Enrollment Tokens).
SFT_SERVER_ENROLLMENT_TOKEN=
